################################################################# usb
create_clock -period 16.667 -name usb_clk_60m -waveform {0.000 8.334} [get_ports usb_clk_60m]
set_property -dict {PACKAGE_PIN M15 IOSTANDARD LVCMOS33} [get_ports -quiet {usb_data[0]}]
set_property -dict {PACKAGE_PIN L16 IOSTANDARD LVCMOS33} [get_ports -quiet {usb_data[1]}]
set_property -dict {PACKAGE_PIN N22 IOSTANDARD LVCMOS33} [get_ports -quiet {usb_data[2]}]
set_property -dict {PACKAGE_PIN M16 IOSTANDARD LVCMOS33} [get_ports -quiet {usb_data[3]}]
set_property -dict {PACKAGE_PIN K16 IOSTANDARD LVCMOS33} [get_ports -quiet {usb_data[4]}]
set_property -dict {PACKAGE_PIN M22 IOSTANDARD LVCMOS33} [get_ports -quiet {usb_data[5]}]
set_property -dict {PACKAGE_PIN M20 IOSTANDARD LVCMOS33} [get_ports -quiet {usb_data[6]}]
set_property -dict {PACKAGE_PIN N20 IOSTANDARD LVCMOS33} [get_ports -quiet {usb_data[7]}]
set_property -dict {PACKAGE_PIN K19 IOSTANDARD LVCMOS33} [get_ports -quiet usb_siwu_n]
set_property -dict {PACKAGE_PIN K18 IOSTANDARD LVCMOS33} [get_ports -quiet usb_clk_60m]
set_property -dict {PACKAGE_PIN M13 IOSTANDARD LVCMOS33} [get_ports -quiet usb_rd_n]
set_property -dict {PACKAGE_PIN L13 IOSTANDARD LVCMOS33} [get_ports -quiet usb_wr_n]
set_property -dict {PACKAGE_PIN L21 IOSTANDARD LVCMOS33} [get_ports -quiet usb_rxf_n]
set_property -dict {PACKAGE_PIN M21 IOSTANDARD LVCMOS33} [get_ports -quiet usb_txf_n]
set_property -dict {PACKAGE_PIN N18 IOSTANDARD LVCMOS33} [get_ports -quiet usb_oe_n]